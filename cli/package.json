{
  "name": "@avsbhq/cli",
  "version": "3.9.2",
  "description": "CLI tool for local A/B experiment development with the A vs B platform",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "ab-testing",
    "experiments",
    "cli",
    "avsb"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "avsb": "bin/avsb.js"
  },
  "files": [
    "bin",
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avsbhq/avsb-js.git",
    "directory": "cli"
  },
  "homepage": "https://github.com/avsbhq/avsb-js/tree/main/cli#readme",
  "bugs": {
    "url": "https://github.com/avsbhq/avsb-js/issues"
  },
  "scripts": {
    "build": "node build.mjs",
