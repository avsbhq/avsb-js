{
  "name": "@avsbhq/solid",
  "version": "1.1.3",
  "description": "Solid SDK for A vs B feature flags and experiments: signals, a provider, SolidStart helpers, and test helpers.",
  "keywords": [
    "avsb",
    "feature-flags",
    "ab-testing",
    "experiments",
    "solid",
    "solidjs",
    "solid-start",
    "sdk"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "solid": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./solid-start": {
      "import": {
        "types": "./dist/solid-start.d.ts",
        "default": "./dist/solid-start.js"
      },
      "require": {
        "types": "./dist/solid-start.d.cts",
        "default": "./dist/solid-start.cjs"
      }
    },
    "./testing": {
      "solid": "./src/testing.tsx",
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avsbhq/avsb-js.git",
    "directory": "packages/avsb-solid"
  },
  "homepage": "https://github.com/avsbhq/avsb-js/tree/main/packages/avsb-solid#readme",
  "bugs": {
    "url": "https://github.com/avsbhq/avsb-js/issues"
  },
  "scripts": {
    "prebuild": "node ../avsb-core/scripts/writeSdkVersion.mjs",
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@solidjs/start": ">=1.0.0",
    "solid-js": ">=1.8.0"
  },
  "peerDependenciesMeta": {
    "@solidjs/start": {
      "optional": true
    }
  },
  "dependencies": {
    "@avsbhq/browser": "^1.5.0",
    "@avsbhq/core": "^1.6.0"
  },
  "devDependencies": {
    "happy-dom": "^14.0.0",
    "solid-js": "^1.8.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vite-plugin-solid": "^2.10.0",
    "vitest": "^4.1.4"
  }
}
