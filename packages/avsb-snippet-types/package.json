{
  "name": "@avsbhq/snippet-types",
  "version": "1.5.1",
  "description": "TypeScript declarations for window.avsb, the A vs B web-snippet API",
  "keywords": [
    "avsb",
    "ab-testing",
    "experiments",
    "types",
    "typescript",
    "snippet"
  ],
  "license": "MIT",
