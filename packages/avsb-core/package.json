{
  "name": "@avsbhq/core",
  "version": "1.7.0",
  "description": "Shared evaluation engine and types for the A vs B SDKs: flag evaluation, audiences, bucketing, and the datafile contract.",
  "keywords": [
    "avsb",
    "feature-flags",
    "ab-testing",
    "experiments",
    "evaluation",
    "sdk"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./engine": {
      "import": {
        "types": "./dist/engine.d.ts",
        "default": "./dist/engine.js"
      },
      "require": {
        "types": "./dist/engine.d.cts",
        "default": "./dist/engine.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avsbhq/avsb-js.git",
    "directory": "packages/avsb-core"
  },
  "homepage": "https://github.com/avsbhq/avsb-js/tree/main/packages/avsb-core#readme",
  "bugs": {
    "url": "https://github.com/avsbhq/avsb-js/issues"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  }
}
