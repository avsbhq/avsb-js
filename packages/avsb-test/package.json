{
  "name": "@avsbhq/test",
  "version": "1.3.1",
  "description": "Test utilities for the A vs B SDKs: a browser-shaped mock, a server-shaped mock, real test clients, datafile fixtures, a fluent flag builder, and evaluation recorders.",
  "keywords": [
    "avsb",
    "feature-flags",
    "ab-testing",
    "experiments",
    "testing",
    "mock",
    "vitest",
    "jest"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./fixtures": {
      "import": {
        "types": "./dist/fixtures.d.ts",
        "default": "./dist/fixtures.js"
      },
      "require": {
        "types": "./dist/fixtures.d.cts",
        "default": "./dist/fixtures.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./vitest": {
      "import": {
        "types": "./dist/vitest.d.ts",
        "default": "./dist/vitest.js"
      },
      "require": {
        "types": "./dist/vitest.d.cts",
        "default": "./dist/vitest.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avsbhq/avsb-js.git",
    "directory": "packages/avsb-test"
  },
  "homepage": "https://github.com/avsbhq/avsb-js/tree/main/packages/avsb-test#readme",
  "bugs": {
    "url": "https://github.com/avsbhq/avsb-js/issues"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@avsbhq/browser": "^1.5.0",
    "@avsbhq/core": "^1.6.0",
    "@avsbhq/utils": "^1.2.1"
  },
  "devDependencies": {
    "@avsbhq/node": "^1.8.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "jsdom": "^25.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.4"
  }
}
