{
  "name": "@avsbhq/react",
  "version": "1.1.3",
  "description": "React SDK for A vs B feature flags and experiments: typed hooks, a StrictMode-safe provider, exposure helpers, and test helpers.",
  "keywords": [
    "avsb",
    "feature-flags",
    "ab-testing",
    "experiments",
    "react",
    "hooks",
    "sdk"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avsbhq/avsb-js.git",
    "directory": "packages/avsb-react"
  },
  "homepage": "https://github.com/avsbhq/avsb-js/tree/main/packages/avsb-react#readme",
  "bugs": {
    "url": "https://github.com/avsbhq/avsb-js/issues"
  },
  "scripts": {
    "prebuild": "node ../avsb-core/scripts/writeSdkVersion.mjs",
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "dependencies": {
    "@avsbhq/browser": "^1.5.0",
    "@avsbhq/core": "^1.6.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  }
}
